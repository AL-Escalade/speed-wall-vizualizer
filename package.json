{
  "name": "voie-vitesse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint --type-aware -A prefer-named-capture-group packages/",
    "build": "tsc -b && tsc --noEmit -p packages/cli/tsconfig.scripts.json && bun run --filter='@voie-vitesse/web' build:web",
    "build:core": "bun run --filter='@voie-vitesse/core' build",
    "build:cli": "bun run --filter='@voie-vitesse/cli' build",
    "build:web": "bun run --filter='@voie-vitesse/web' build:web",
    "dev:web": "bun run --filter='@voie-vitesse/web' dev",
    "generate": "bun run --filter='@voie-vitesse/cli' generate --",
    "generate:base": "bun run --filter='@voie-vitesse/cli' generate -- -c ../../data/base.json -o ../../output/base.svg",
    "generate:assets": "bun scripts/generate-bundled-assets.ts",
    "generate:doc-images": "bun run --filter='@voie-vitesse/cli' generate:doc-images",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "eslint-plugin-react-refresh": "^0.5.3",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.0.15"
  }
}
